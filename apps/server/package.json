{
  "name": "@jobportal/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "DATABASE_URL=${DATABASE_URL:-'postgresql://postgres:postgres@localhost:5432/jobportal?schema=public'} prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "echo 'lint not configured yet'",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-'postgresql://postgres:postgres@localhost:5432/jobportal?schema=public'} prisma generate",
    "prisma:migrate": "DATABASE_URL=${DATABASE_URL:-'postgresql://postgres:postgres@localhost:5432/jobportal?schema=public'} prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "bullmq": "^5.58.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "ioredis": "^5.6.1",
    "morgan": "^1.10.0",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.3",
    "multer": "^2.0.2",
    "prisma": "^6.5.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  }
}
